{
  "name": "@geekjourneyx/dsh-md2wechat",
  "description": "DeepSeek Harness tools for preparing Markdown articles with an external md2wechat CLI",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "scripts": {
    "check:boundaries": "node scripts/check-boundaries.mjs .",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint src tests scripts",
    "test": "vitest run",
    "test:installed": "node scripts/installed-acceptance.mjs",
    "build": "tsc -b && tsdown",
    "prepare": "pnpm run build",
    "pack:check": "vitest run tests/integration/package-contents.test.ts"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.5",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.5",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "oxlint": "1.76.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geekjourneyx/dsh-md2wechat.git"
  }
}
